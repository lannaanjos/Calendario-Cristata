
<resources>
    <style name="Base.Theme.Cristata" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cor_principal</item>
        <item name="colorOnPrimary">@color/cor_texto_sobre_primaria</item>
        <item name="android:windowBackground">@color/cor_background</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="fontFamily">@font/open_sans</item>
    </style>

    <style name="Theme.Cristata" parent="Base.Theme.Cristata" />

    <!-- Títulos -->
    <style name="TextoTitulo">
        <item name="android:fontFamily">@font/alfa_slab_one</item>
        <item name="android:textColor">@color/cor_titulo</item>
        <item name="android:textSize">40sp</item>
    </style>

    <!-- Subtítulos -->
    <style name="TextoSubtitulo" parent="TextoTitulo">
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Cantos arredondados da imagem do pássaro -->
    <style name="ImagemPassaro" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Linha da tela de configurações, icon à esquerda e texto itálico -->
    <style name="LinhaConfig">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:fontFamily">@font/open_sans_italic</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/cor_texto</item>
    </style>
    <!-- Letras dos dias da semana no calendário -->
    <style name="DiaSemana">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cor_texto</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>