<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_background"
    android:padding="16dp">

    <!-- painel verde que contém as linhas -->
    <LinearLayout
        android:id="@+id/painelConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cor_painel_secundario"
        android:orientation="vertical">

        <!-- versao -->
        <TextView
            android:id="@+id/txtVersao"
            style="@style/LinhaConfig"
            android:background="@color/cor_painel"
            android:text="@string/config_versao"
            app:drawableStartCompat="@drawable/ic_config_versao" />

        <!-- saiba mais -->
        <TextView
            android:id="@+id/txtSaibaMais"
            style="@style/LinhaConfig"
            android:text="@string/config_saiba_mais"
            app:drawableStartCompat="@drawable/ic_config_saiba_mais" />

        <!-- iluminacao -->
        <TextView
            android:id="@+id/txtModoEscuro"
            style="@style/LinhaConfig"
            android:background="@color/cor_painel"
            android:text="@string/config_modo_escuro"
            app:drawableStartCompat="@drawable/ic_config_modo_iluminacao" />

        <!-- redefinir coleção -->
        <TextView
            android:id="@+id/txtRedefinir"
            style="@style/LinhaConfig"
            android:text="@string/config_redefinir"
            app:drawableStartCompat="@drawable/ic_config_redefinir" />

        <!-- api -->
        <TextView
            android:id="@+id/txtSobreApi"
            style="@style/LinhaConfig"
            android:background="@color/cor_painel"
            android:text="@string/config_sobre_api"
            app:drawableStartCompat="@drawable/ic_config_api" />

        <!-- bloco p empurrar os créditos pra baixo -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- créditos -->
        <TextView
            android:id="@+id/txtCreditos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:fontFamily="@font/open_sans_italic"
            android:gravity="start"
            android:text="@string/config_creditos"
            android:textColor="@color/cor_texto"
            android:textSize="10sp" />

    </LinearLayout>
</FrameLayout>