<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_background"
    android:padding="16dp">

    <!-- painel verde que contém as linhas -->
    <LinearLayout
        android:id="@+id/painelConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cor_painel_secundario"
        android:orientation="vertical">

        <!-- versao -->
        <TextView
            android:id="@+id/txtVersao"
            style="@style/LinhaConfig"
            android:background="@color/cor_painel"
            android:text="@string/config_versao"
            app:drawableStartCompat="@drawable/ic_config_versao" />

        <!-- saiba mais -->
        <TextView
            android:id="@+id/txtSaibaMais"
            style="@style/LinhaConfig"
            android:text="@string/config_saiba_mais"
            app:drawableStartCompat="@drawable/ic_config_saiba_mais" />

        <!-- iluminacao -->
        <TextView
            android:id="@+id/txtModoEscuro"
            style="@style/LinhaConfig"
            android:background="@color/cor_painel"
            android:text="@string/config_modo_escuro"
            app:drawableStartCompat="@drawable/ic_config_modo_iluminacao" />

    </LinearLayout>
</FrameLayout>