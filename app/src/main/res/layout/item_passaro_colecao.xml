<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/txtNomeColecao"
        style="@style/TextoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtNomeCientificoColecao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_italic"
        android:textColor="@color/cor_texto"
        android:textSize="14sp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPassaroColecao"
        android:layout_width="200dp"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/descricao_imagem_passaro"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ImagemPassaro" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/cor_painel_secundario" />
</LinearLayout>