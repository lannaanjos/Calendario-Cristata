<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_background"
    android:orientation="vertical">

    <TextView
        style="@style/TextoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_header"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/titulo_calendario" />

    <com.kizitonwose.calendar.view.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@android:color/white"
        app:cv_dayViewResource="@layout/calendario_dia"
        app:cv_monthHeaderResource="@layout/calendario_cabecalho_mes"
        app:cv_outDateStyle="endOfGrid" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginVertical="24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_agenda_card"
        android:orientation="vertical">

        <TextView
            style="@style/TextoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/agenda_hoje"
            android:textSize="22sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/cor_principal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEventos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <Button
            android:id="@+id/btnNovoEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:backgroundTint="@color/cor_principal"
            android:text="NOVO EVENTO"
            android:textColor="@color/cor_texto_sobre_primaria" />
    </LinearLayout>
</LinearLayout>