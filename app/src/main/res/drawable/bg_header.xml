<?xml version="1.0" encoding="utf-8"?>
<!-- "pássaro do dia" -->
<!-- header: faixa bege com linha escura em cima e embaixo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- camada de baixo: a cor das linhas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cor_principal" />
        </shape>
    </item>
    <!-- camada de cima: a faixa bege, recuada 3dp para as linhas aparecerem -->
    <item
        android:top="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cor_painel" />
        </shape>
    </item>
</layer-list>